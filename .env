# =============================================================================
# DevSecVault - Docker Compose Environment Variables
# =============================================================================
# Copy to .env.local for local overrides (gitignored).
# NEVER commit real secrets to this file in production.
# =============================================================================

# PostgreSQL
POSTGRES_DB=devsecvault
POSTGRES_USER=devsecvault
POSTGRES_PASSWORD=changeme_dev
POSTGRES_PORT=5433

# Meilisearch
MEILI_MASTER_KEY=changeme_dev_meili_key
MEILI_PORT=7700

# Symfony
APP_ENV=dev
APP_SECRET=changeme_app_secret

# Cyber Toolbox payload-body encryption (AES-256-GCM key, base64 of 32 bytes)
# Override with a real key in `.env.local` (gitignored) for local docker-compose.
# In prod this is provisioned via `php bin/console secrets:set ENCRYPTION_KEY --env=prod`.
ENCRYPTION_KEY=changeme_dev_encryption_key_base64_32b

# Keycloak (external, already running on VPS)
KEYCLOAK_URL=https://auth.calixteair.fr:4443
KEYCLOAK_REALM=devsecvault
KEYCLOAK_CLIENT_ID=devsecvault-backend

# Angular dev server
ANGULAR_PORT=4200

# Backend API (nginx FastCGI proxy in front of PHP-FPM)
# 8080 by default to avoid conflicts with Symfony CLI's `symfony serve` (8000)
API_PORT=8080

# External Docker network name (same as VPS: nginx-reverse-proxy)
PROXY_NETWORK=nginx-reverse-proxy
