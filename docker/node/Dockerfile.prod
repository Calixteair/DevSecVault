FROM node:22-alpine AS builder

WORKDIR /app

# pnpm (version de packageManager dans package.json) via corepack
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile

COPY frontend/ .
RUN pnpm exec ng build --configuration=production

# --- Serve with nginx ---
FROM nginx:alpine

RUN apk upgrade --no-cache

RUN rm -rf /usr/share/nginx/html/*
COPY --from=builder /app/dist/frontend/browser /usr/share/nginx/html
RUN if [ -f /usr/share/nginx/html/index.csr.html ] && [ ! -f /usr/share/nginx/html/index.html ]; then \
      mv /usr/share/nginx/html/index.csr.html /usr/share/nginx/html/index.html; \
    fi
COPY docker/node/nginx.prod.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
