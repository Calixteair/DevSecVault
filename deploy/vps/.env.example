# =============================================================================
# DevSecVault - VPS Production Environment
# Copy this file to .env and fill in the real values.
# This file stays on the VPS only. NEVER commit .env to git.
# =============================================================================

# PostgreSQL
POSTGRES_DB=devsecvault
POSTGRES_USER=devsecvault
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_SECRET

# Meilisearch
MEILI_MASTER_KEY=CHANGE_ME_RANDOM_SECRET

# Symfony
APP_ENV=prod
APP_SECRET=CHANGE_ME_RANDOM_HEX_64

# Keycloak
KEYCLOAK_REALM=devsecvault
KEYCLOAK_CLIENT_ID=devsecvault-backend

# DockerHub (pour pull les images)
DOCKERHUB_USERNAME=your-dockerhub-username
