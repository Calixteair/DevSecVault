# =============================================================================
# DevSecVault - Docker Compose Environment Variables
# =============================================================================
# Copy to .env.local for local overrides (gitignored).
# NEVER commit real secrets to this file in production.
# =============================================================================

# PostgreSQL
POSTGRES_DB=devsecvault
POSTGRES_USER=devsecvault
POSTGRES_PASSWORD=changeme_dev
POSTGRES_PORT=5433

# Meilisearch
MEILI_MASTER_KEY=changeme_dev_meili_key
MEILI_PORT=7700

# Symfony
APP_ENV=dev
APP_SECRET=changeme_app_secret

# Keycloak (external, already running on VPS)
KEYCLOAK_URL=https://auth.calixteair.fr
KEYCLOAK_REALM=devsecvault
KEYCLOAK_CLIENT_ID=devsecvault-backend

# Angular dev server
ANGULAR_PORT=4200

# External Docker network name (same as VPS: nginx-reverse-proxy)
PROXY_NETWORK=nginx-reverse-proxy
